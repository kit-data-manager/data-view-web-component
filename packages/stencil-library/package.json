{
  "name": "@kit-data-manager/data-view-web-component",
  "version": "0.1.1",
  "description": "A generic Stencil Web Component that can be used to render single elements in lists showing customizable details, actions, and tags, e.g., for rendering search results.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.js",
  "es2017": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/stencil-library/stencil-library.esm.js",
      "require": "./dist/stencil-library/stencil-library.cjs.js"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    },
    "./hydrate": {
      "types": "./hydrate/index.d.ts",
      "import": "./hydrate/index.js",
      "require": "./hydrate/index.cjs.js"
    }
  },
  "files": [
    "dist/",
    "loader/",
    "hydrate/"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "lint": "eslint packages/stencil-library/src/**/*{.ts,.tsx}",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "build-watch": "stencil build --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "stencil build --docs"
  },
  "dependencies": {
    "@stencil/core": "^4.41.0",
    "iconify-icon": "^3.0.0"
  },
  "devDependencies": {
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@stencil/react-output-target": "^1.0.0",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/web-components": "^10.1.11",
    "@storybook/web-components-vite": "^10.1.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.2.0",
    "jest-cli": "^30.2.0",
    "lit": "^3.0.2",
    "puppeteer": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.1.11",
    "typescript": "^5.8.3",
    "eslint-plugin-storybook": "10.2.13"
  },
  "license": "Apache-2.0",
  "keywords": [
    "stencil",
    "webcomponent",
    "webcomponents"
  ],
  "author": {
    "name": "Thomas Jejkal",
    "url": "https://orcid.org/0000-0003-2804-688X",
    "email": "thomas.jejkal@kit.edu"
  },
  "homepage": "https://kit-data-manager.github.io/data-view-web-component",
  "repository": {
    "type": "git",
    "url": "https://github.com/kit-data-manager/data-view-web-component"
  },
  "bugs": {
    "url": "https://github.com/kit-data-manager/data-view-web-component/issues"
  },
  "contributors": [
    {
      "name": "Thomas Jejkal",
      "url": "https://orcid.org/0000-0003-2804-688X",
      "email": "thomas.jejkal@kit.edu"
    },
    {
      "name": "Arno Wiest"
    }
  ],
  "overrides": {
    "storybook": "$storybook"
  }
}